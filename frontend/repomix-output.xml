<file path="src/screens/Resultado/Resultado.tsx">
import type { PricingResult } from '../../types/pricing';
import { formatCurrency } from '../../lib/pricing';
import './Resultado.css';

interface ResultadoProps {
  result: PricingResult | null;
  onBack: () => void;
}

export default function Resultado({ result, onBack }: ResultadoProps) {
  if (!result) {
    return (
      <div className="resultado resultado--empty">
        <p>Todavía no hay ninguna cotización calculada.</p>
        <button onClick={onBack} type="button">
          Ir a la calculadora
        </button>
      </div>
    );
  }

  const { currency } = result.input;

  return (
    <div className="resultado">
      <h1>Resultados</h1>

      <div className="card resultado__breakdown">
        <div className="resultado__row">
          <span>Precio material</span>
          <span>{formatCurrency(result.materialCost, currency)}</span>
        </div>
        <div className="resultado__row">
          <span>Precio luz</span>
          <span>{formatCurrency(result.electricityCost, currency)}</span>
        </div>
        <div className="resultado__row">
          <span>Margen de error</span>
          <span>{formatCurrency(result.errorBuffer, currency)}</span>
        </div>
        <div className="resultado__row resultado__row--total">
          <span>Subtotal</span>
          <span>{formatCurrency(result.subtotal, currency)}</span>
        </div>
        <div className="resultado__row">
          <span>Precio marcado (×{result.input.profitMultiplier})</span>
          <span>{formatCurrency(result.markedUpPrice, currency)}</span>
        </div>
        <div className="resultado__row">
          <span>Consumos extra</span>
          <span>{formatCurrency(result.input.extraCosts, currency)}</span>
        </div>
      </div>

      <div className="resultado__total">
        <span className="resultado__total-label">TOTAL A COBRAR</span>
        <span className="resultado__total-value">
          {formatCurrency(result.finalPrice, currency)}
        </span>
      </div>

      <button className="resultado__back" onClick={onBack} type="button">
        Calcular otra pieza
      </button>
    </div>
  );
}
