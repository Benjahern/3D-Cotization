<file path="src/App.tsx">
import { useState } from 'react';
import BottomTabBar, { type TabKey } from './components/layout/BottomTabBar';
import Calculadora from './screens/Calculadora/Calculadora';
import Resultado from './screens/Resultado/Resultado';
import { calculatePrice } from './lib/pricing';
import type { PricingResult } from './types/pricing';
import './App.css';

export default function App() {
  const [activeTab, setActiveTab] = useState<TabKey>('calculadora');
  const [result, setResult] = useState<PricingResult | null>(null);

  const handleCalculate: React.ComponentProps<typeof Calculadora>['onCalculate'] = (input) => {
    setResult(calculatePrice(input));
    setActiveTab('resultado');
  };

  return (
    <div className="app">
      {activeTab === 'calculadora' && <Calculadora onCalculate={handleCalculate} />}
      {activeTab === 'resultado' && (
        <Resultado result={result} onBack={() => setActiveTab('calculadora')} />
      )}

      <BottomTabBar
        activeTab={activeTab}
        onChange={setActiveTab}
        tabs={[
          { key: 'calculadora', label: 'Calculadora' },
          { key: 'resultado', label: 'Resultado' },
        ]}
      />
    </div>
  );
}
</file>

