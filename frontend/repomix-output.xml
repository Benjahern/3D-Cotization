<file path="src/components/layout/BottomTabBar.tsx">
import './BottomTabBar.css';

export type TabKey = 'calculadora' | 'resultado';

interface Tab {
  key: TabKey;
  label: string;
  disabled?: boolean;
}

interface BottomTabBarProps {
  tabs: Tab[];
  activeTab: TabKey;
  onChange: (tab: TabKey) => void;
}

export default function BottomTabBar({ tabs, activeTab, onChange }: BottomTabBarProps) {
  return (
    <nav className="bottom-tab-bar">
      {tabs.map((tab) => (
        <button
          key={tab.key}
          className={`bottom-tab-bar__item ${activeTab === tab.key ? 'is-active' : ''}`}
          onClick={() => onChange(tab.key)}
          disabled={tab.disabled}
          type="button"
        >
          {tab.label}
        </button>
      ))}
    </nav>
  );
}
