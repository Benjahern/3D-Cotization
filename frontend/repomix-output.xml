<file path="src/screens/Calculadora/Calculadora.tsx">
import { useState } from 'react';
import type { PricingInput } from '../../type/pricing';
import { CURRENCIES, PROFIT_MULTIPLIERS } from '../../type/pricing';
import './Calculadora.css';

interface CalculadoraProps {
  onCalculate: (input: PricingInput) => void;
}

const initialInput: PricingInput = {
  currency: 'CLP',
  filamentCostPerKg: 15000,
  kwhPrice: 250,
  printerWatts: 45,
  errorMarginPercent: 10,
  printHours: 2,
  extraMinutes: 0,
  filamentGrams: 30,
  extraCosts: 0,
  profitMultiplier: 4,
};

const MULTIPLIER_REFERENCES: { value: number; label: string }[] = [
  { value: 2, label: 'Alto volumen / descuento' },
  { value: 2.5, label: 'Volumen medio' },
  { value: 3, label: 'Mayorista' },
  { value: 3.5, label: 'Intermedio' },
  { value: 4, label: 'Minorista' },
  { value: 5, label: 'Llaveros / piezas chicas' },
];

export default function Calculadora({ onCalculate }: CalculadoraProps) {
  const [input, setInput] = useState<PricingInput>(initialInput);
  const [showReferences, setShowReferences] = useState(true);

  const update = <K extends keyof PricingInput>(key: K, value: PricingInput[K]) => {
    setInput((prev) => ({ ...prev, [key]: value }));
  };

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    onCalculate(input);
  };

  return (
    <div className="calculadora">
      <h1>Cotizador 3D</h1>

      <form onSubmit={handleSubmit} className="calculadora__form">
        <label className="field">
          Moneda
          <select
            value={input.currency}
            onChange={(e) => update('currency', e.target.value)}
          >
            {CURRENCIES.map((c) => (
              <option key={c.code} value={c.code}>
                {c.label}
              </option>
            ))}
          </select>
        </label>

        <section className="card">
          <h2>Costos fijos</h2>
          <div className="card__grid">
            <label className="field">
              Precio del filamento (por kg)
              <input
                type="number"
                min={0}
                value={input.filamentCostPerKg}
                onChange={(e) => update('filamentCostPerKg', Number(e.target.value))}
              />
            </label>

            <label className="field">
              Precio del kWh
              <input
                type="number"
                min={0}
                value={input.kwhPrice}
                onChange={(e) => update('kwhPrice', Number(e.target.value))}
              />
            </label>

            <label className="field">
              Consumo de la impresora (W)
              <input
                type="number"
                min={0}
                value={input.printerWatts}
                onChange={(e) => update('printerWatts', Number(e.target.value))}
              />
            </label>

            <label className="field">
              Margen de error (%)
              <input
                type="number"
                min={0}
                value={input.errorMarginPercent}
                onChange={(e) => update('errorMarginPercent', Number(e.target.value))}
              />
            </label>
          </div>
        </section>

        <section className="card">
          <h2>Pieza</h2>
          <div className="card__grid">
            <label className="field">
              Horas de impresión
              <input
                type="number"
                min={0}
                step={0.1}
                value={input.printHours}
                onChange={(e) => update('printHours', Number(e.target.value))}
              />
            </label>

            <label className="field">
              Minutos adicionales
              <input
                type="number"
                min={0}
                value={input.extraMinutes}
                onChange={(e) => update('extraMinutes', Number(e.target.value))}
              />
            </label>

            <label className="field">
              Gramos de filamento
              <input
                type="number"
                min={0}
                value={input.filamentGrams}
                onChange={(e) => update('filamentGrams', Number(e.target.value))}
              />
            </label>

            <label className="field">
              Consumos extra
              <input
                type="number"
                min={0}
                value={input.extraCosts}
                onChange={(e) => update('extraCosts', Number(e.target.value))}
              />
            </label>
          </div>
        </section>

        <section className="card">
          <h2>Margen de ganancia</h2>
          <p className="card__label">Multiplicador</p>
          <div className="multiplier-grid">
            {PROFIT_MULTIPLIERS.map((m) => (
              <button
                key={m}
                type="button"
                className={`multiplier-btn ${input.profitMultiplier === m ? 'is-active' : ''}`}
                onClick={() => update('profitMultiplier', m)}
              >
                ×{m}
              </button>
            ))}
          </div>

          <label className="field">
            Personalizado
            <span className="field__hint">Si necesitás otro valor, ingresalo acá (ej: 2.8).</span>
            <input
              type="number"
              min={0}
              step={0.1}
              value={input.profitMultiplier}
              onChange={(e) => update('profitMultiplier', Number(e.target.value))}
            />
          </label>

          <button
            type="button"
            className="references-toggle"
            onClick={() => setShowReferences((v) => !v)}
          >
            {showReferences ? '▴' : '▾'} Referencias
          </button>

          {showReferences && (
            <ul className="references-list">
              {MULTIPLIER_REFERENCES.map((r) => (
                <li key={r.value}>
                  ×{r.value.toFixed(1)} → {r.label}
                </li>
              ))}
            </ul>
          )}
        </section>

        <button type="submit" className="calculadora__submit">
          Calcular precio
        </button>
      </form>
    </div>
  );
}
