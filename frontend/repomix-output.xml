<file path="src/screens/Calculadora/Calculadora.css">
.calculadora {
  padding: 24px 16px 100px;
  max-width: 520px;
  margin: 0 auto;
}

.calculadora h1 {
  font-size: 20px;
  font-weight: 600;
  margin: 0 0 20px;
  color: var(--text);
}

.calculadora__form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 18px;
}

.card h2 {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  margin: 0 0 14px;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.card__label {
  font-size: 13px;
  color: var(--text-muted);
  margin: 0 0 8px;
}

.card__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

@media (max-width: 420px) {
  .card__grid {
    grid-template-columns: 1fr;
  }
}

.field {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 13px;
  color: var(--text-muted);
}

.field__hint {
  font-size: 11px;
  color: var(--text-muted);
  font-style: italic;
}

.field input,
.field select {
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text);
  font-size: 14px;
}

.field input:focus,
.field select:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-soft-bg);
}

.multiplier-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 8px;
  margin-bottom: 16px;
}

@media (max-width: 420px) {
  .multiplier-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.multiplier-btn {
  padding: 10px 0;
  border-radius: var(--radius-sm);
  border: 1px solid var(--border);
  background: var(--surface-muted);
  color: var(--text-muted);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
}

.multiplier-btn.is-active {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--accent-text-on);
}

.references-toggle {
  margin-top: 14px;
  background: none;
  border: none;
  color: var(--accent-strong);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  padding: 0;
}

.references-list {
  list-style: none;
  margin: 10px 0 0;
  padding: 12px 0 0;
  border-top: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 12.5px;
  color: var(--text-muted);
}

.calculadora__submit {
  margin-top: 4px;
  padding: 14px;
  border-radius: var(--radius-md);
  border: none;
  background: var(--accent);
  color: var(--accent-text-on);
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
}

.calculadora__submit:hover {
  background: var(--accent-strong);
}
